{
  "name": "ambigo-backend",
  "version": "1.0.0",
  "description": "AmbiGo Driver Backend — Hono + TypeScript + MongoDB + Socket.io",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
